{
	"folders": [
		{ "path": ".", "name": "AssemblyFiles" },
		{ "path": "../../../../../BuildFiles", "name": "BuildFiles" },
		{ "path": "../../../../../DependenciesFiles" },
		{ "path": "../../../DesignFiles" },
		{ "path": "../../../HeaderFiles" },
		{ "path": "../../../SharedFiles" },
		{ "path": "../../../SourceFiles" },
		{ "path": "../../../UnitTestFiles" }
	],
	"settings": {
		"C_Cpp.default.configurationProvider": "ms-vscode.makefile-tools",
		"C_Cpp.default.cStandard": "c89",
		"C_Cpp.default.includePath": [
			"${workspaceFolder}/**",
			"**/../../HeaderFiles",
			"**/../../SharedFiles",
			"${env:ECO_FRAMEWORK}/Eco.Core1/SharedFiles",
			"${env:ECO_FRAMEWORK}/Eco.InterfaceBus1/SharedFiles",
			"${env:ECO_FRAMEWORK}/Eco.MemoryManager1/SharedFiles",
			"${env:ECO_FRAMEWORK}/Eco.FileSystemManagement1/SharedFiles",
			"${env:ECO_FRAMEWORK}/Eco.System1/SharedFiles"
		],
		"makefile.configurations": [
			{ "name": "EcoIntegralSimpson Static|x86 Debug", "makeArgs": ["TARGET=1", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIntegralSimpson Static|x86 Release", "makeArgs": ["TARGET=1", "ARCH=x86", "DEBUG=0"] },
			{ "name": "EcoIntegralSimpson Static|x64 Debug", "makeArgs": ["TARGET=1", "ARCH=x64", "DEBUG=1"] },
			{ "name": "EcoIntegralSimpson Static|x64 Release", "makeArgs": ["TARGET=1", "ARCH=x64", "DEBUG=0"] },
			{ "name": "EcoIntegralSimpson Dynamic|x86 Debug", "makeArgs": ["TARGET=0", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIntegralSimpson Dynamic|x86 Release", "makeArgs": ["TARGET=0", "ARCH=x86", "DEBUG=0"] },
			{ "name": "EcoIntegralSimpson Dynamic|x64 Debug", "makeArgs": ["TARGET=0", "ARCH=x64", "DEBUG=1"] },
			{ "name": "EcoIntegralSimpson Dynamic|x64 Release", "makeArgs": ["TARGET=0", "ARCH=x64", "DEBUG=0"] },
			{ "name": "EcoIntegralSimpsonUnitTest Static|x86 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=1", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIntegralSimpsonUnitTest Static|x64 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=1", "ARCH=x64", "DEBUG=1"] },
			{ "name": "EcoIntegralSimpsonUnitTest Dynamic|x86 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=0", "ARCH=x86", "DEBUG=1"] },
			{ "name": "EcoIntegralSimpsonUnitTest Dynamic|x64 Debug", "makeArgs": ["-f", "MakefileExe", "TARGET=0", "ARCH=x64", "DEBUG=1"] }
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "DEBUG: EcoIntegralSimpsonUnitTest Static|x86",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x86/StaticDebug/EcoIntegralSimpson.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x86/StaticDebug",
				"preLaunchTask": "build EcoIntegralSimpsonUnitTest StaticDebug|x86",
				"MIMode": "gdb",
				"miDebuggerPath": "${env:ECO_TOOLCHAIN}/eco-i686-win-dwarf-gcc-13.2.0-win-x86_64/bin/gdb.exe"
			},
			{
				"name": "DEBUG: EcoIntegralSimpsonUnitTest Static|x64",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x64/StaticDebug/EcoIntegralSimpson.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x64/StaticDebug",
				"preLaunchTask": "build EcoIntegralSimpsonUnitTest StaticDebug|x64",
				"MIMode": "gdb",
				"miDebuggerPath": "${env:ECO_TOOLCHAIN}/eco-x86_64-win-dwarf-gcc-13.2.0-win-x86_64/bin/gdb.exe"
			},
			{
				"name": "DEBUG: EcoIntegralSimpsonUnitTest Dynamic|x86",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x86/DynamicDebug/EcoIntegralSimpson.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x86/DynamicDebug",
				"preLaunchTask": "build EcoIntegralSimpsonUnitTest DynamicDebug|x86",
				"MIMode": "gdb",
				"miDebuggerPath": "${env:ECO_TOOLCHAIN}/eco-i686-win-dwarf-gcc-13.2.0-win-x86_64/bin/gdb.exe"
			},
			{
				"name": "DEBUG: EcoIntegralSimpsonUnitTest Dynamic|x64",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Linux/x64/DynamicDebug/EcoIntegralSimpson.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Linux/x64/DynamicDebug",
				"preLaunchTask": "build EcoIntegralSimpsonUnitTest DynamicDebug|x64",
				"MIMode": "gdb",
				"miDebuggerPath": "gdb"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
            {
                "label": "Eco: build",
                "type": "shell",
                "command": "${workspaceFolder:AssemblyFiles}/build.sh",
                "args": [
                    "build"
                ],
                "problemMatcher": [
                    "$gcc"
                ],
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "Eco: test",
                "type": "shell",
                "command": "${workspaceFolder:AssemblyFiles}/build.sh",
                "args": [
                    "test"
                ],
                "problemMatcher": [
                    "$gcc"
                ],
                "group": "test"
            },
            {
                "label": "Eco: verify",
                "type": "shell",
                "command": "${workspaceFolder:AssemblyFiles}/build.sh",
                "args": [
                    "verify"
                ],
                "problemMatcher": [
                    "$gcc"
                ],
                "group": "test"
            },

			{
				"label": "build all configurations",
				"type": "shell",
				"command": "${workspaceFolder:AssemblyFiles}/build.sh",
				"group": { "kind": "build", "isDefault": false },
				"presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared" },
				"problemMatcher": []
			},
			{
				"label": "build EcoIntegralSimpson StaticDebug|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpson StaticRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpson DynamicDebug|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpson DynamicRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpson StaticDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },		
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpson StaticRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=1", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpson DynamicDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },		
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpson DynamicRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "Makefile", "TARGET=0", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared" },			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest StaticDebug|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson StaticDebug|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest StaticRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson StaticRelease|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest DynamicDebug|x86",
				"type": "shell",
				"command": "make",
				"args": ["-f", "MakefileExe", "TARGET=0", "DEBUG=1", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson DynamicDebug|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest DynamicRelease|x86",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=0", "DEBUG=0", "ARCH=x86" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson DynamicRelease|x86"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest StaticDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson StaticDebug|x64"],				
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest StaticRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=1", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson StaticRelease|x64"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest DynamicDebug|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=0", "DEBUG=1", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson DynamicDebug|x64"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "build EcoIntegralSimpsonUnitTest DynamicRelease|x64",
				"type": "shell",
				"command": "make",
				"args": [ "-f", "MakefileExe", "TARGET=0", "DEBUG=0", "ARCH=x64" ],
				"group": "build",
				"dependsOn": ["build EcoIntegralSimpson DynamicRelease|x64"],			
				"problemMatcher": [ "$gcc" ]
			},
			{
				"label": "Clean All",
				"type": "shell",
				"command": "make clean",
				"options": { "cwd": "${workspaceFolder:AssemblyFiles}" }
			}
		]
	}
}
